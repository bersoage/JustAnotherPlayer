<?xml version="1.0" encoding="utf-8"?>
<!-- Narrow side panel for TV: leaves the video visible. D-pad friendly. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

    <TextView
        android:id="@+id/audio_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="#B0B0B0"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

      <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/audio_gain"
          android:textColor="#FFFFFF"
          android:textSize="14sp" />

      <TextView
          android:id="@+id/audio_gain_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="#FFFFFF"
          android:textSize="14sp" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/audio_gain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:minHeight="40dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

      <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/audio_balance"
          android:textColor="#FFFFFF"
          android:textSize="14sp" />

      <TextView
          android:id="@+id/audio_balance_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="#FFFFFF"
          android:textSize="14sp" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/audio_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:minHeight="40dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

      <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/audio_voice"
          android:textColor="#FFFFFF"
          android:textSize="14sp" />

      <TextView
          android:id="@+id/audio_voice_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="#FFFFFF"
          android:textSize="14sp" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/audio_voice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:minHeight="40dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

      <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/audio_delay"
          android:textColor="#FFFFFF"
          android:textSize="14sp" />

      <TextView
          android:id="@+id/audio_sync_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="#FFFFFF"
          android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/audio_sync_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:text="@string/audio_sync_open"
        android:textSize="14sp" />

    <Button
        android:id="@+id/audio_effects_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minHeight="44dp"
        android:text="@string/effects_open"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/video_hdr_mode"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/video_hdr_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

      <RadioButton
          android:id="@+id/video_hdr_dv"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:minHeight="44dp"
          android:focusable="true"
          android:text="@string/video_hdr_dv"
          android:textColor="#FFFFFF"
          android:textSize="14sp" />

      <RadioButton
          android:id="@+id/video_hdr_10"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:minHeight="44dp"
          android:focusable="true"
          android:text="@string/video_hdr_10"
          android:textColor="#FFFFFF"
          android:textSize="14sp" />
    </RadioGroup>

    <Button
        android:id="@+id/audio_reset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minHeight="44dp"
        android:text="@string/audio_reset"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/audio_diag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#B0B0B0"
        android:textSize="12sp" />

  </LinearLayout>
</ScrollView>
