<?xml version="1.0" encoding="utf-8"?>
<!-- Sized for TV: large text and tap/focus targets, usable with the D-pad. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/audio_gain"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

      <SeekBar
          android:id="@+id/audio_gain"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:focusable="true"
          android:minHeight="56dp" />

      <TextView
          android:id="@+id/audio_gain_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:minWidth="96dp"
          android:gravity="end"
          android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/audio_balance"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

      <SeekBar
          android:id="@+id/audio_balance"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:focusable="true"
          android:minHeight="56dp" />

      <TextView
          android:id="@+id/audio_balance_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:minWidth="160dp"
          android:gravity="end"
          android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/audio_delay"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

      <Button
          android:id="@+id/audio_delay_minus"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:minHeight="56dp"
          android:minWidth="96dp"
          android:text="@string/audio_delay_less"
          android:textSize="20sp" />

      <TextView
          android:id="@+id/audio_delay_value"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="center"
          android:textSize="24sp" />

      <Button
          android:id="@+id/audio_delay_plus"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:minHeight="56dp"
          android:minWidth="96dp"
          android:text="@string/audio_delay_more"
          android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/audio_delay_hint"
        android:textSize="16sp" />

    <Button
        android:id="@+id/audio_reset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:minHeight="56dp"
        android:text="@string/audio_reset"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/video_hdr_mode"
        android:textSize="20sp" />

    <RadioGroup
        android:id="@+id/video_hdr_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

      <RadioButton
          android:id="@+id/video_hdr_dv"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:minHeight="56dp"
          android:focusable="true"
          android:text="@string/video_hdr_dv"
          android:textSize="20sp" />

      <RadioButton
          android:id="@+id/video_hdr_10"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:minHeight="56dp"
          android:focusable="true"
          android:text="@string/video_hdr_10"
          android:textSize="20sp" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/video_hdr_hint"
        android:textSize="16sp" />

  </LinearLayout>
</ScrollView>
